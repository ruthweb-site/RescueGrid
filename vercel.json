{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/brief.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/brief",
      "dest": "api/brief.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
